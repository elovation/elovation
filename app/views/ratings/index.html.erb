<% content_for :title, "#{@game.name} leaderboard" %>
<header class="page-header">
  <div class="title">
    <p class="eyebrow"><%= link_to @game.name, game_path(@game) %></p>
    <h1>Leaderboard</h1>
  </div>
</header>
<%= turbo_frame_tag "ratings" do %>
  <%= render "games/leaderboard", ratings: @game.all_ratings %>
<% end %>
