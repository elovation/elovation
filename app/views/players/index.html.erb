<% content_for :title, "Players" %>
<header class="page-header">
  <div class="title">
    <h1>Players</h1>
  </div>
  <div class="actions">
    <%= link_to "New player", new_player_path, data: { turbo_frame: "new_player" }, class: "btn btn-primary" %>
  </div>
</header>

<%= turbo_frame_tag "new_player", target: "_top" %>

<ul class="player-cards" id="players">
  <%= render @players %>
</ul>
