<div class="form-panel">
  <%= form_with model: player, class: "form" do |f| %>
    <div class="field">
      <%= f.label :name %>
      <%= f.text_field :name, required: true %>
      <%= errors_for player, :name %>
    </div>
    <div class="field">
      <%= f.label :email %>
      <%= f.email_field :email, aria: { describedby: "email-help" } %>
      <p class="help" id="email-help">Optional, and never shown. Used to show the player's <a href="https://gravatar.com/">Gravatar</a>, through <a href="https://robohash.org/">Robohash</a>.</p>
      <%= errors_for player, :email %>
    </div>
    <div class="form-actions">
      <%= f.button (player.persisted? ? "Save player" : "Add player"), class: "btn btn-primary" %>
      <%= link_to "Cancel", (player.persisted? ? player_path(player) : players_path), class: "btn btn-warning" %>
    </div>
  <% end %>
</div>
