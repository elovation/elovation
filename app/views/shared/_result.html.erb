<% deletable = result.most_recent? %>
<li class="result<%= " is-latest" if deletable %>">
  <p class="outcome">
    <%= render "shared/outcome", result: result, links: true, past: false %>
    <% if show_game %><span class="in-game">in <%= link_to result.game.name, result.game %></span><% end %>
  </p>
  <p class="result-meta">
    <time datetime="<%= result.created_at.iso8601 %>"><%= format_time(result.created_at) %></time>
    <% if deletable %>
      <%= link_to "Delete", game_result_path(result.game, result), class: "btn btn-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
    <% end %>
  </p>
</li>
