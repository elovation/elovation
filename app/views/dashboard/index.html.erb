<% content_for :title, "Games" %>
<% if @players.length > 1 %>
  <header class="page-header">
    <div class="title">
      <h1>Games</h1>
    </div>
    <div class="actions">
      <%= link_to "New game", new_game_path, class: "btn btn-primary", data: { turbo_frame: "new_game" } %>
    </div>
  </header>
  <%= turbo_frame_tag "new_game", target: "_top" %>

  <div class="columns">
    <section class="column-main" aria-label="Games">
      <ul class="game-tiles">
        <% @games.each do |game| %>
          <li class="game-tile">
            <h2><%= link_to game.name, game_path(game), class: "tile-link" %></h2>
            <p class="meta">
              <%= game.rating_system.name %> · <%= pluralize(game.results.length, "result") %> · <%= pluralize(game.players.length, "player") %><% unless game.allow_ties %> · no ties<% end %>
            </p>
            <% result = game.recent_results.limit(1).first %>
            <% if result %>
              <p class="last-result">
                <%= render "shared/outcome", result: result, links: false, past: true %>
                <time datetime="<%= result.created_at.iso8601 %>"><%= format_time(result.created_at) %></time>
              </p>
            <% else %>
              <p class="last-result meta">No results yet</p>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>

    <section class="column-side" aria-labelledby="players-heading">
      <div class="section-heading">
        <h2 id="players-heading">Players</h2>
        <%= link_to "All players", players_path %>
      </div>
      <ul class="player-list">
        <% @players.each do |player| %>
          <li><%= link_to player_path(player), class: "player" do %><%= avatar(player, size: 24) %><span><%= player.name %></span><% end %></li>
        <% end %>
      </ul>
    </section>
  </div>
<% else %>
  <header class="page-header">
    <div class="title">
      <h1>Games</h1>
  </div>
  </header>
  <div class="empty">
    <p>You have no players yet. Add at least two players to get started.</p>
    <%= link_to "Add players", players_path, class: "btn btn-primary" %>
  </div>
<% end %>
