<% content_for :title, "Add a #{@game.name} result" %>
<header class="page-header">
  <div class="title">
    <p class="eyebrow"><%= link_to @game.name, game_path(@game) %></p>
    <h1>Add result</h1>
  </div>
</header>

<div class="form-panel">
  <% if @team_game || @team_count > 2 %>
    <div class="form-intro">
      <% if @team_game %>
        <p>Pick one or more players for each team. To pick several, hold Shift, or Cmd on a Mac (Ctrl on Windows), while you click.</p>
      <% end %>
      <% if @team_count > 2 %>
        <p>Enter finishers from first place on. Only the first two are required. If two finish level, choose "ties" between them and they share the place.</p>
      <% end %>
    </div>
  <% end %>

  <%= form_for [@game, @result], html: { id: "form-results", class: "form" } do |f| %>
    <% if @result.errors.any? %>
      <div class="form-errors" role="alert">
        <% @result.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>
    <ol class="result-slots" role="list">
      <% @team_count.times do |index| %>
        <% submitted = @submitted_teams[index.to_s] || {} %>
        <li class="field">
          <label for="result_teams_<%= index %>_players">
            <% if @team_count > 2 %>
              <%= (index + 1).ordinalize %>
            <% elsif index.zero? %>
              <%= @team_game ? "Winners" : "Winner" %>
            <% else %>
              <%= @team_game ? "Losers" : "Loser" %>
            <% end %>
          </label>
          <%= select "result[teams][#{index}]", "players", player_options, { include_blank: !@team_game, selected: Array.wrap(submitted[:players]) }, multiple: @team_game, size: (@team_game ? 8 : nil) %>
          <% if index != @team_count - 1 %>
            <% if @game.allow_ties %>
              <%= select "result[teams][#{index}]", :relation, [["defeats", "defeats"], ["ties", "ties"]], { selected: submitted[:relation] }, class: "relation", aria: { label: "Result between #{(index + 1).ordinalize} and #{(index + 2).ordinalize}" } %>
            <% else %>
              <%= hidden_field_tag "result[teams][#{index}][relation]", :defeats, id: nil %>
              <span class="relation" aria-hidden="true">defeats</span>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ol>
    <div class="form-actions">
      <%= f.submit "Save result", class: "btn btn-primary" %>
      <%= link_to "Cancel", game_path(@game), class: "btn btn-warning" %>
    </div>
  <% end %>
</div>
