<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [content_for(:title), brand_title].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= preload_link_tag "atkinson-hyperlegible-next.woff2", crossorigin: "anonymous" %>
    <%= preload_link_tag "archivo.woff2", crossorigin: "anonymous" %>
    <%= stylesheet_link_tag "fonts", "tokens", "themes", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body data-theme="<%= current_theme %>">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main">
        <%= link_to brand_title, root_path, class: "brand" %>
        <ul>
          <li><%= nav_link "Games", root_path, section: :games %></li>
          <li><%= nav_link "Players", players_path, section: :players %></li>
        </ul>
      </nav>
    </header>
    <main id="main" class="page">
      <%= yield %>
    </main>
    <% if brand_title != "Elovation" %>
      <footer class="site-footer">Powered by <a href="https://github.com/elovation/elovation">Elovation</a></footer>
    <% end %>
  </body>
</html>
