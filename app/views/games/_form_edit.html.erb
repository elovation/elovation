<div class="form-panel" data-controller="game">
  <%= form_with model: game, class: "form" do |f| %>
    <div class="field">
      <%= f.label :name %>
      <%= f.text_field :name, required: true %>
      <%= errors_for game, :name %>
    </div>
    <div class="field">
      <span class="label">Rating system</span>
      <p><%= game.rating_system.description %></p>
    </div>
    <% format = game.rating_system.supported_format %>
    <% unless format.fixed_players_per_team %>
      <div class="field">
        <%= f.label :max_number_of_players_per_team, "Maximum players per team" %>
        <%= f.number_field :max_number_of_players_per_team, min: 1, class: "input-short", aria: { describedby: "max-players-help" } %>
        <p class="help" id="max-players-help">Leave blank for no limit.</p>
        <%= errors_for game, :max_number_of_players_per_team %>
      </div>
    <% end %>
    <% unless format.fixed_teams %>
      <div class="field">
        <%= f.label :max_number_of_teams, "Maximum teams" %>
        <%= f.number_field :max_number_of_teams, min: 2, class: "input-short", aria: { describedby: "max-teams-help" } %>
        <p class="help" id="max-teams-help">Leave blank for no limit.</p>
        <%= errors_for game, :max_number_of_teams %>
      </div>
    <% end %>
    <div class="field field-checkbox">
      <%= f.check_box :allow_ties %>
      <%= f.label :allow_ties, "Allow ties" %>
    </div>
    <div class="form-actions">
      <%= f.button "Save game", class: "btn btn-primary" %>
      <%= link_to "Cancel", game_path(game), class: "btn btn-warning" %>
    </div>
  <% end %>
</div>
