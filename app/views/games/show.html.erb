<% content_for :title, @game.name %>
<header class="page-header">
  <div class="title">
    <p class="eyebrow"><%= @game.rating_system.name %></p>
    <h1><%= @game.name %></h1>
  </div>
  <div class="actions">
    <%= link_to "Add result", new_game_result_path(@game), class: "btn btn-primary" %>
    <%= link_to "Edit", edit_game_path(@game), data: { turbo_frame: dom_id(@game) }, class: "btn" %>
    <% if @game.results.empty? %>
      <%= button_to "Delete", game_path(@game), method: :delete, form: { data: { turbo_confirm: "Are you sure?" } }, class: "btn btn-danger" %>
    <% end %>
  </div>
</header>
<%= turbo_frame_tag dom_id(@game), target: "_top" %>

<div class="columns">
  <section class="column-side" aria-labelledby="leaderboard-heading">
    <h2 id="leaderboard-heading">Leaderboard</h2>
    <%= turbo_frame_tag "ratings", target: "_top" do %>
      <% if @ratings.empty? %>
        <p class="empty">No ratings yet. Add a result to start the leaderboard.</p>
      <% elsif @active_ratings.empty? %>
        <p class="empty">No one has played in the last four weeks.</p>
      <% else %>
        <%= render "games/leaderboard", ratings: @active_ratings, swatches: @history.any? %>
      <% end %>
      <% if @ratings.size > @active_ratings.size %>
        <p><%= link_to "Show everyone, including players inactive for four weeks", game_ratings_path(@game), data: { turbo_frame: "ratings" } %></p>
      <% end %>
    <% end %>
  </section>

  <section class="column-main" aria-labelledby="results-heading">
    <h2 id="results-heading">Recent results</h2>
    <% if @game.recent_results.any? %>
      <%= render partial: "shared/results", object: @game.recent_results, locals: { show_game: false } %>
    <% else %>
      <p class="empty">No results yet. Play some games!</p>
    <% end %>
  </section>
</div>

<% if @history.any? %>
  <section class="chart" aria-labelledby="progress-heading">
    <h2 id="progress-heading">Progress</h2>
    <p class="help">The top <%= [@active_ratings.size, GamesHelper::CHART_HIGHLIGHTS].min %> players are in colour, matching the leaderboard. Everyone else is grey.</p>
    <%= rating_chart rating_chart_series(@history, @active_ratings.map(&:player_id)), height: "26rem" %>
  </section>
<% end %>
